# Copy this file to .env and fill in the values.
#   copy .env.example .env
# .env is git-ignored. Never commit real secrets.

# Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# True only on a developer laptop. Must be False on the APIIT server.
DEBUG=True

# Comma-separated host names the site may be served under.
ALLOWED_HOSTS=localhost,127.0.0.1

# True = show the "PROTOTYPE – sample data" banner and the role switcher.
PROTOTYPE_MODE=True

# Database. Leave unset to use the local SQLite file (db.sqlite3).
# Production example:
# DATABASE_URL=postgres://nc_user:password@db-host:5432/nc_tracker

# Email. The console backend prints emails in the terminal instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nctracker@apiit.lk
# Real email later (values from APIIT IT):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=nctracker@apiit.lk
# EMAIL_HOST_PASSWORD=
